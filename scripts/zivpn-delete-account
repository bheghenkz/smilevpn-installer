#!/bin/bash
set -e

DB="/etc/zivpn/users.db"
LIMITDB="/etc/zivpn/user-limit.db"
CONFIG="/etc/zivpn/config.json"

user="${1:-}"

[ -n "$user" ] || read -p "Username : " user

if ! grep -q "^${user}:" "$DB"; then
    echo "User not found"
    exit 1
fi

sed -i "/^${user}:/d" "$DB"
sed -i "/^${user}:/d" "$LIMITDB" 2>/dev/null || true

python3 - <<PY2
import json, os
path="$CONFIG"
user="$user"

data={}
if os.path.exists(path):
    try:
        with open(path) as f:
            data=json.load(f)
    except Exception:
        data={}

auth=data.setdefault("auth",{})
cfg=auth.setdefault("config",[])
auth["config"]=[x for x in cfg if x != user]

with open(path,"w") as f:
    json.dump(data,f,indent=2)
PY2

systemctl restart zivpn 2>/dev/null || service zivpn restart 2>/dev/null || true

echo "━━━━━━━━━━━━━━━━━━━"
echo "  ZIVPN DELETED"
echo "━━━━━━━━━━━━━━━━━━━"
echo "Username : $user"
echo "━━━━━━━━━━━━━━━━━━━"
