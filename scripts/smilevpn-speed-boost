#!/bin/bash
set -e

cat >/etc/sysctl.d/99-smilevpn-speed.conf <<'SYS'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_window_scaling=1
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.tcp_tw_reuse=1
net.ipv4.ip_local_port_range=10240 65535
net.core.somaxconn=65535
net.core.netdev_max_backlog=250000
net.ipv4.tcp_max_syn_backlog=65535
net.ipv4.tcp_fin_timeout=15
net.ipv4.tcp_keepalive_time=600
net.ipv4.tcp_keepalive_intvl=30
net.ipv4.tcp_keepalive_probes=5
net.core.rmem_max=134217728
net.core.wmem_max=134217728
net.ipv4.tcp_rmem=4096 87380 134217728
net.ipv4.tcp_wmem=4096 65536 134217728
SYS

sysctl --system >/dev/null 2>&1 || true

mkdir -p /etc/systemd/system/xray.service.d
cat >/etc/systemd/system/xray.service.d/20-smilevpn-speed.conf <<'EOF2'
[Service]
LimitNOFILE=1048576
Restart=always
RestartSec=3
EOF2

mkdir -p /etc/systemd/system/nginx.service.d
cat >/etc/systemd/system/nginx.service.d/20-smilevpn-speed.conf <<'EOF2'
[Service]
LimitNOFILE=1048576
EOF2

systemctl daemon-reload
systemctl restart xray 2>/dev/null || true
systemctl restart nginx 2>/dev/null || true

echo "✅ SmileVPN speed boost applied"
