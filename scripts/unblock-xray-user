#!/bin/bash
set -e

SERVICE="$1"
USER="$2"
CONF="/etc/xray/config.json"
RCONF="/usr/local/etc/xray/config.json"
STATE="/etc/limit-state"

[ -n "$SERVICE" ] && [ -n "$USER" ] || exit 1

SAFE_USER="$(echo "$USER" | tr -cd 'A-Za-z0-9_.@-')"
SAFE_SERVICE="$(echo "$SERVICE" | tr -cd 'A-Za-z0-9_.@-')"
BACKUP="$STATE/$SAFE_SERVICE-$SAFE_USER.config.backup"

[ -f "$BACKUP" ] || exit 0

cp "$BACKUP" "$RCONF"
chmod 644 "$RCONF"

python3 - "$RCONF" "$USER" <<'PYFIX'
from pathlib import Path
import sys

path = Path(sys.argv[1])
user = sys.argv[2]

lines = path.read_text().splitlines(True)
out = []
for line in lines:
    if f'"email": "{user}"' in line:
        line = line.replace('"password": "BLOCKED-', '"password": "')
    out.append(line)

path.write_text("".join(out))
PYFIX

if xray run -test -config "$RCONF" >/tmp/xray-unblock-test.log 2>&1; then
    cp "$BACKUP" "$CONF"
    chmod 644 "$CONF"
    systemctl restart xray
    rm -f "$BACKUP"
    exit 0
else
    echo "XRAY TEST FAILED. Unblock not applied. See /tmp/xray-unblock-test.log" >&2
    exit 1
fi
