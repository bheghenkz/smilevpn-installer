#!/bin/bash
USERNAME=$1
EXPIRED_AT=$2
IPLIMIT="${3:-5}"
QUOTA="9999"

if [ -z "$USERNAME" ] || [ -z "$EXPIRED_AT" ]; then
    echo "Usage: trojango-create-account USERNAME expired|trial IPLIMIT"
    exit 1
fi

[ "$EXPIRED_AT" = "trial" ] && EXPIRED_AT=$(date -d "+1 hour" "+%Y-%m-%d %H:%M")

DOMAIN=$(cat /etc/xray/domain)
IP=$(cat /etc/xray/ip 2>/dev/null || curl -s ipv4.icanhazip.com)
CITY=$(cat /etc/xray/city 2>/dev/null || echo "Unknown")
PASS=$(openssl rand -hex 8)

mkdir -p /etc/trojango/akun /etc/trojan-go /var/www/html

[ "$IPLIMIT" = "0" ] && IPLIMIT="9999"
echo "$IPLIMIT" >/etc/trojango/${USERNAME}IP
echo "$((QUOTA * 1024 * 1024 * 1024))" >/etc/trojango/${USERNAME}

# inject password
python3 - <<PY
import json
p="/etc/trojan-go/config.json"
data=json.load(open(p))
pw="${PASS}"
data.setdefault("password", [])
if pw not in data["password"]:
    data["password"].append(pw)
data.setdefault("websocket", {})
data["websocket"]["enabled"] = True
data["websocket"]["path"] = "/trojango"
open(p,"w").write(json.dumps(data, indent=2))
PY

systemctl restart trojan-go >/dev/null 2>&1

LINK_TCP="trojan://${PASS}@${DOMAIN}:2087?sni=${DOMAIN}#${USERNAME}-TCP"
LINK_WS="trojan://${PASS}@${DOMAIN}:2087?type=ws&security=tls&host=${DOMAIN}&path=%2Ftrojango&sni=${DOMAIN}#${USERNAME}-WS"

cat > /var/www/html/trojango-${USERNAME}.txt <<END
proxies:
-  name: ${USERNAME}-TCP
  server: ${DOMAIN}
  port: 2087
  type: trojan
  password: ${PASS}
  sni: ${DOMAIN}
  network: tcp
  tls: true
  udp: true

- name: ${USERNAME}-WS
  server: ${DOMAIN}
  port: 2087
  type: trojan
  password: ${PASS}
  sni: ${DOMAIN}
  network: ws
  tls: true
  ws-opts:
    path: /trojango
    headers:
      Host: ${DOMAIN}
  udp: true

# LINK
${LINK_TCP}
${LINK_WS}
END

cat /var/www/html/trojango-${USERNAME}.txt
