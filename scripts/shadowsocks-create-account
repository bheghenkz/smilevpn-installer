#!/bin/bash
set -e
USERNAME="$1"; EXPIRED_AT="$2"; IPLIMIT="${3:-5}"
if [ -z "$USERNAME" ] || [ -z "$EXPIRED_AT" ]; then echo "Usage: shadowsocks-create-account USERNAME expired|trial IPLIMIT"; exit 1; fi
[ "$EXPIRED_AT" = "trial" ] && EXPIRED_AT=$(date -d "+1 hour" "+%Y-%m-%d %H:%M")
[ "$IPLIMIT" = "0" ] && IPLIMIT="9999"
IP=$(cat /etc/xray/ip 2>/dev/null || curl -4 -s ipv4.icanhazip.com || true)
ISP=$(cat /etc/xray/isp 2>/dev/null || echo "Unknown ISP")
CITY=$(cat /etc/xray/city 2>/dev/null || echo "Unknown City")
DOMAIN=$(cat /etc/xray/domain)
METHOD="aes-128-gcm"
PASS=$(openssl rand -hex 8)
mkdir -p /etc/shadowsocks/akun /var/www/html
echo "$IPLIMIT" >/etc/shadowsocks/${USERNAME}IP
sed -i "/^#ss ${USERNAME} /,/^,{/d" /etc/xray/config.json
sed -i "/^#ssg ${USERNAME} /,/^,{/d" /etc/xray/config.json
sed -i '/#ssws$/a\#ss '"$USERNAME $EXPIRED_AT"'\
,{"method":"aes-128-gcm","password": "'""${PASS}""'","email": "'""${USERNAME}""'"}' /etc/xray/config.json
sed -i '/#ssgrpc$/a\#ssg '"$USERNAME $EXPIRED_AT"'\
,{"method":"aes-128-gcm","password": "'""${PASS}""'","email": "'""${USERNAME}""'"}' /etc/xray/config.json
sync_xray() {
    mkdir -p /usr/local/etc/xray

    python3 <<'PYX'
import re
from pathlib import Path

src = Path("/etc/xray/config.json")
dst = Path("/usr/local/etc/xray/config.json")

s = src.read_text()
s = re.sub(r'^\s*#.*$', '', s, flags=re.MULTILINE)
s = re.sub(r',\s*}', '}', s)
s = re.sub(r',\s*]', ']', s)

dst.write_text(s)
PYX

    chmod 755 /usr/local/etc /usr/local/etc/xray
    chmod 644 /usr/local/etc/xray/config.json

    if command -v xray >/dev/null 2>&1; then
        xray run -test -config /usr/local/etc/xray/config.json >/tmp/smilevpn-xray-test.log 2>&1 || {
            cat /tmp/smilevpn-xray-test.log
            exit 1
        }
    fi

    systemctl restart xray >/dev/null 2>&1 || true
}
sync_xray
SS_BASE=$(echo -n "${METHOD}:${PASS}" | base64 -w0)
SS_LINK_TLS="ss://${SS_BASE}@${DOMAIN}:443?plugin=v2ray-plugin%3Btls%3Bhost%3D${DOMAIN}%3Bpath%3D%2Fss-ws%2F${USERNAME}#${USERNAME}"
SS_LINK_NTLS="ss://${SS_BASE}@${DOMAIN}:80?plugin=v2ray-plugin%3Bhost%3D${DOMAIN}%3Bpath%3D%2Fss-ws%2F${USERNAME}#${USERNAME}"
SS_LINK_GRPC="ss://${SS_BASE}@${DOMAIN}:443?plugin=xray-plugin%3Btls%3Bhost%3D${DOMAIN}%3Bmode%3Dgrpc%3BserviceName%3Dss-grpc#${USERNAME}"
cat >/var/www/html/shadowsocks-${USERNAME}.txt <<END
proxies:
- name: ${USERNAME}-SS-WS-TLS
  server: ${DOMAIN}
  port: 443
  type: ss
  cipher: ${METHOD}
  password: ${PASS}
  plugin: v2ray-plugin
  plugin-opts:
    mode: websocket
    tls: true
    host: ${DOMAIN}
    path: /ss-ws/${USERNAME}
  udp: true

- name: ${USERNAME}-SS-WS-NTLS
  server: ${DOMAIN}
  port: 80
  type: ss
  cipher: ${METHOD}
  password: ${PASS}
  plugin: v2ray-plugin
  plugin-opts:
    mode: websocket
    tls: false
    host: ${DOMAIN}
    path: /ss-ws/${USERNAME}
  udp: true

- name: ${USERNAME}-SS-GRPC
  server: ${DOMAIN}
  port: 443
  type: ss
  cipher: ${METHOD}
  password: ${PASS}
  plugin: xray-plugin
  plugin-opts:
    mode: grpc
    tls: true
    host: ${DOMAIN}
    serviceName: ss-grpc
  udp: true

# Links
${SS_LINK_TLS}
${SS_LINK_NTLS}
${SS_LINK_GRPC}
END
cat >/etc/shadowsocks/akun/log-create-${USERNAME}.log <<END
🔐 SHADOWSOCKS ACCOUNT

Username   : ${USERNAME}
Password   : ${PASS}
Expired    : ${EXPIRED_AT}
Limit IP   : ${IPLIMIT} IP

🌐 SERVER
Domain     : ${DOMAIN}
IP         : ${IP}
ISP        : ${ISP}
City       : ${CITY}

🔌 PORT
TLS        : 443
Non TLS    : 80
gRPC       : 443
Path       : /ss-ws/${USERNAME}
Service    : ss-grpc

<<<<<<< HEAD
🚀 UDP CUSTOM
UDP Port   : 1-65535
BadVPN     : 7300-7302

=======
>>>>>>> 9597f3a39a3a03153bfcb749f7317def6c29f7b8
🔗 LINK
OpenClash  : https://${DOMAIN}/shadowsocks-${USERNAME}.txt

TLS
${SS_LINK_TLS}

Non TLS
${SS_LINK_NTLS}

gRPC
${SS_LINK_GRPC}
END
cat /etc/shadowsocks/akun/log-create-${USERNAME}.log
