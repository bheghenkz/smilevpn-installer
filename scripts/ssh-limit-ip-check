#!/bin/bash

exec 9>/run/smilevpn-ssh-limit.lock
flock -n 9 || exit 0


STATE_DIR="/etc/limit-state"
SSH_DIR="/etc/xray/sshx"
LOG_FILE="/var/log/ssh-limit.log"
PANEL_URL=$(cat /etc/smilevpn-panel-url 2>/dev/null)
API_TOKEN=$(cat /etc/smilevpn-api-token 2>/dev/null)

NOW=$(date +%s)
MAX_STRIKE=3
BLOCK_SECONDS=600

mkdir -p "$STATE_DIR"

[ -d "$SSH_DIR" ] || exit 0

send_log() {
    [ -z "$PANEL_URL" ] && return
    [ -z "$API_TOKEN" ] && return

    PANEL_URL="${PANEL_URL%/}"
    case "$PANEL_URL" in
        */api/security/ip-limit) ;;
        *) PANEL_URL="$PANEL_URL/api/security/ip-limit" ;;
    esac

    BLOCKED_UNTIL_SEND="$7"
    if echo "$BLOCKED_UNTIL_SEND" | grep -Eq '^[0-9]+$'; then
        BLOCKED_UNTIL_SEND="$(date -d "@$BLOCKED_UNTIL_SEND" '+%F %T' 2>/dev/null || echo "$BLOCKED_UNTIL_SEND")"
    fi

    PAYLOAD=$(cat <<JSON
{
  "username": "$1",
  "service": "ssh",
  "limit": $2,
  "count": $3,
  "ips": "$4",
  "strike": $5,
  "action": "$6",
  "blocked_until": "$BLOCKED_UNTIL_SEND"
}
JSON
)

    for TRY in 1 2 3; do
        HTTP_CODE=$(curl -sS -m 8 -o /tmp/smilevpn-panel-response.txt -w "%{http_code}" \
            -X POST "$PANEL_URL" \
            -H "Authorization: Bearer $API_TOKEN" \
            -H "Content-Type: application/json" \
            --data-binary "$PAYLOAD" 2>>/var/log/smilevpn-ssh-limit-panel.log)

        RESP="$(cat /tmp/smilevpn-panel-response.txt 2>/dev/null)"
        echo "$(date '+%F %T') API try=$TRY action=$6 user=$1 code=$HTTP_CODE resp=$RESP" >> /var/log/smilevpn-ssh-limit-panel.log

        [ "$HTTP_CODE" = "200" ] && break
        sleep 2
    done
}


get_user_ips() {
    user="$1"

    python3 - "$user" <<'PYX'
import re
import subprocess
import sys

user = sys.argv[1]
ips = set()

ss = subprocess.getoutput("ss -tnp state established")
auth = subprocess.getoutput("tail -n 5000 /var/log/auth.log 2>/dev/null")

login_ips = set()
for line in auth.splitlines():
    m = re.search(r"Password auth succeeded for '([^']+)' from ([0-9.]+):", line)
    if m and m.group(1) == user:
        login_ips.add(m.group(2))

for line in ss.splitlines():
    if "sshd" not in line and "dropbear" not in line:
        continue

    parts = line.split()
    if len(parts) < 4:
        continue

    local = parts[2]
    remote = parts[3]

    if not re.search(r":(22|2222|2223|109|143)$", local):
        continue

    rip = re.sub(r"^\[|\]$", "", remote)
    rip = re.sub(r":\d+$", "", rip)

    if not re.match(r"^\d+\.\d+\.\d+\.\d+$", rip):
        continue

    if "dropbear" in line:
        if rip in login_ips:
            ips.add(rip)
        continue

    pids = re.findall(r"pid=(\d+)", line)
    for pid in pids:
        args = subprocess.getoutput(f"ps -o args= -p {pid}").strip()
        owner = subprocess.getoutput(f"ps -o user= -p {pid}").strip()

        if owner == user or re.search(r"sshd:\s+" + re.escape(user) + r"(@|\s)", args):
            ips.add(rip)

# UDP Custom / HTTP Custom / HTTP Mini
# Only count recent udp-custom auth logs to avoid re-block after unblock.
syslog = subprocess.getoutput("journalctl -u udp-custom -n 300 --no-pager 2>/dev/null")
now_ts = int(subprocess.getoutput("date +%s") or "0")
year = subprocess.getoutput("date +%Y").strip() or "1970"

for line in syslog.splitlines():
    if "udp-custom" not in line:
        continue

    m = re.search(r"\[src:([0-9.]+):\d+\].*\[user:([^\]]+)\]", line)
    if not m:
        continue

    line_ts = now_ts

    rip = m.group(1)
    ruser = m.group(2)

    if ruser == user:
        ips.add(rip)

print("\n".join(sorted(ips)))
PYX
}

for file in "$SSH_DIR"/*IP; do
    [ -f "$file" ] || continue

    USERNAME="$(basename "$file" IP)"
    LIMIT="$(cat "$file" | tr -dc '0-9')"

    [ "$USERNAME" = "root" ] && continue
    [ -z "$LIMIT" ] && LIMIT=0
    [ "$LIMIT" = "0" ] && continue

    if ! id "$USERNAME" >/dev/null 2>&1; then
        rm -f "$STATE_DIR/ssh-$USERNAME."*
        continue
    fi

    STRIKE_FILE="$STATE_DIR/ssh-$USERNAME.strike"
    BLOCK_FILE="$STATE_DIR/ssh-$USERNAME.blocked_until"
    IPS_FILE="$STATE_DIR/ssh-$USERNAME.ips"
    SUSPENDED_FILE="$STATE_DIR/ssh-$USERNAME.suspended"
    COOLDOWN_FILE="$STATE_DIR/ssh-$USERNAME.cooldown"

    STRIKE="$(cat "$STRIKE_FILE" 2>/dev/null || echo 0)"
    BLOCK_UNTIL="$(cat "$BLOCK_FILE" 2>/dev/null || echo 0)"

    if [ "$BLOCK_UNTIL" -gt "$NOW" ] 2>/dev/null; then
        usermod -L "$USERNAME" >/dev/null 2>&1 || true
        pkill -KILL -u "$USERNAME" sshd >/dev/null 2>&1 || true
        pkill -KILL -u "$USERNAME" dropbear >/dev/null 2>&1 || true
        continue
    fi

    if [ "$BLOCK_UNTIL" != "0" ] && [ "$BLOCK_UNTIL" -le "$NOW" ] 2>/dev/null; then
        rm -f "$BLOCK_FILE" "$SUSPENDED_FILE" "$STRIKE_FILE" "$IPS_FILE"
        echo $((NOW + 30)) > "$COOLDOWN_FILE"
        usermod -U "$USERNAME" >/dev/null 2>&1 || true
        passwd -u "$USERNAME" >/dev/null 2>&1 || true
        pkill -u "$USERNAME" >/dev/null 2>&1 || true
        systemctl restart udp-custom >/dev/null 2>&1 || true
        echo "$(date '+%F %T') SSH UNBLOCK $USERNAME" >> "$LOG_FILE"
        send_log "$USERNAME" "$LIMIT" 0 "unknown" 0 "unblock" ""
        continue
    fi

    if [ -f "$COOLDOWN_FILE" ]; then
        COOLDOWN_UNTIL="$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)"
        if [ "$COOLDOWN_UNTIL" -gt "$NOW" ]; then
            echo "unknown" > "$IPS_FILE"
            continue
        fi
        rm -f "$COOLDOWN_FILE"
    fi

    IPS="$(get_user_ips "$USERNAME")"
    COUNT="$(echo "$IPS" | sed '/^$/d' | wc -l)"
    IPS_COMMA="$(echo "$IPS" | paste -sd "," -)"
    [ -z "$IPS_COMMA" ] && IPS_COMMA="unknown"
    echo "$IPS_COMMA" > "$IPS_FILE"

    # UDP Custom mobile clients can briefly create multiple transient source IPs.
    # Allow small reconnect tolerance before triggering strike/block.
    ALLOW_LIMIT=$((LIMIT + 2))

    if [ "$COUNT" -gt "$ALLOW_LIMIT" ]; then
        STRIKE=$((STRIKE + 1))
        echo "$STRIKE" > "$STRIKE_FILE"

        if [ "$STRIKE" -ge "$MAX_STRIKE" ]; then
            BLOCK_UNTIL=$((NOW + BLOCK_SECONDS))
            echo "$BLOCK_UNTIL" > "$BLOCK_FILE"
            echo "$NOW" > "$SUSPENDED_FILE"
            usermod -L "$USERNAME" >/dev/null 2>&1 || true
            pkill -KILL -u "$USERNAME" sshd >/dev/null 2>&1 || true
            pkill -KILL -u "$USERNAME" dropbear >/dev/null 2>&1 || true
            systemctl restart udp-custom >/dev/null 2>&1 || true
            echo "$(date '+%F %T') SSH BLOCK $USERNAME IP=$COUNT LIMIT=$LIMIT IPS=$IPS_COMMA" >> "$LOG_FILE"
            send_log "$USERNAME" "$LIMIT" "$COUNT" "$IPS_COMMA" "$STRIKE" "block" "$BLOCK_UNTIL"
        else
            pkill -KILL -u "$USERNAME" sshd >/dev/null 2>&1 || true
            pkill -KILL -u "$USERNAME" dropbear >/dev/null 2>&1 || true
            echo "$(date '+%F %T') SSH STRIKE $USERNAME STRIKE=$STRIKE IP=$COUNT LIMIT=$LIMIT IPS=$IPS_COMMA" >> "$LOG_FILE"
            send_log "$USERNAME" "$LIMIT" "$COUNT" "$IPS_COMMA" "$STRIKE" "strike" ""
        fi
    fi
done
