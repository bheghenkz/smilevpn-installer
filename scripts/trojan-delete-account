#!/bin/bash
set -e
USERNAME="$1"
if [ -z "$USERNAME" ]; then echo "Usage: trojan-delete-account USERNAME"; exit 1; fi
sed -i "/^#tr ${USERNAME} /,/^,{/d" /etc/xray/config.json
sed -i "/^#trg ${USERNAME} /,/^,{/d" /etc/xray/config.json
rm -f /etc/trojan/${USERNAME}IP /etc/trojan/${USERNAME} /etc/trojan/akun/log-create-${USERNAME}.log /var/www/html/trojan-${USERNAME}.txt /etc/limit/trojan/${USERNAME}
sync_xray() {
    mkdir -p /usr/local/etc/xray
    mkdir -p /usr/local/etc/xray
cp /etc/xray/config.json /usr/local/etc/xray/config.json
chmod 755 /usr/local/etc /usr/local/etc/xray
chmod 644 /usr/local/etc/xray/config.json
    if command -v xray >/dev/null 2>&1; then
        xray run -test -config /usr/local/etc/xray/config.json >/tmp/smilevpn-xray-test.log 2>&1 || {
            cat /tmp/smilevpn-xray-test.log
            exit 1
        }
    fi
    systemctl restart xray >/dev/null 2>&1 || true
}
sync_xray
