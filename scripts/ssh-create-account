#!/bin/bash



USERNAME="$1"

# Support panel format:
# ssh-create-account USERNAME PASSWORD EXPIRED_AT IPLIMIT
# Also support manual old format:
# ssh-create-account USERNAME expired|trial IPLIMIT
if [ $# -ge 4 ]; then
    PASSWORD="$2"
    EXPIRED_AT="$3"
    IPLIMIT="${4:-2}"
else
    EXPIRED_AT="${2:-1}"
    IPLIMIT="${3:-5}"
    PASSWORD="$(tr -dc A-Za-z0-9 </dev/urandom | head -c 10)"
fi

# SUPPORT TRIAL 1 JAM
if [ "$EXPIRED_AT" = "trial" ]; then
    EXPIRED_AT=$(date -d "+1 hour" "+%Y-%m-%d %H:%M")
fi

IP=$(curl -s ipv4.icanhazip.com)
ISP=$(cat /etc/xray/isp)
CITY=$(cat /etc/xray/city)
DOMAIN=$(cat /etc/xray/domain)

if [ ! -e /etc/xray/sshx ]; then
mkdir -p /etc/xray/sshx
fi
if [ ! -e /etc/xray/sshx/akun ]; then
mkdir -p /etc/xray/sshx/akun
fi
if [ -z ${IPLIMIT} ]; then
IPLIMIT="0"
fi
echo "${IPLIMIT}" >/etc/xray/sshx/${USERNAME}IP

EXPIRED_DATE="$(echo "$EXPIRED_AT" | awk '{print $1}')"
useradd -m -e "${EXPIRED_DATE}" -s /bin/bash "${USERNAME}" &> /dev/null
echo "${USERNAME}:${PASSWORD}" | chpasswd
mkdir -p "/home/${USERNAME}"
chown "${USERNAME}:${USERNAME}" "/home/${USERNAME}"
groupadd -f smilevpn-users
usermod -aG smilevpn-users "${USERNAME}"
echo -e "### ${USERNAME} ${EXPIRED_AT} ${PASSWORD}" >> /etc/xray/ssh

cat > /var/www/html/ssh-$USERNAME.txt <<-END
=========================
   SmileVpn Tunneling 
=========================

Format SSH OVPN Account
=========================
Username         : $USERNAME
Password         : $PASSWORD
=========================
ISP              : $ISP
CITY             : $CITY
IP               : $IP
Host             : $DOMAIN
Port OpenSSH     : 22, 2222, 2223
Port Dropbear    : 109, 143
Port Dropbear WS : -
Port SSH UDP     : 1-65535
Port SSH WS      : -
Port SSH SSL WS  : -
Port SSL/TLS     : 400-900
Port OVPN WS SSL : -
Port OVPN SSL    : -
Port OVPN TCP    : 1194
Port OVPN UDP    : 2200
BadVPN UDP       : 7300, 7301, 7302
=================================
Payload WSS: GET wss://$DOMAIN/ HTTP/1.1[crlf]Host: $DOMAIN[crlf]Upgrade: websocket[crlf][crlf] 
=================================
Payload Enchanced: PATCH / HTTP/1.1[crlf]Host: [host][crlf]Host: ${DOMAIN}[crlf]Upgrade: websocket[crlf]HTTP/ 3600[crlf]Sec-WebSocket-Extensions: superspeed[crlf]
=================================
SSH OpenSSH : $DOMAIN:2222@$USERNAME:$PASSWORD
SSH Dropbear: $DOMAIN:109@$USERNAME:$PASSWORD
=================================
OVPN Download : https://$DOMAIN/
=================================
Berakhir Pada    : $EXPIRED_AT
=================================

END



cat > /etc/xray/sshx/akun/log-create-${USERNAME}.log <<EOF
🔐 SSH ACCOUNT

Username   : ${USERNAME}
Password   : ${PASSWORD}
Expired    : ${EXPIRED_AT}
Limit IP   : ${IPLIMIT} IP

🌐 SERVER
Domain     : ${DOMAIN}
IP         : ${IP}
City       : ${CITY}

🔌 PORT
OpenSSH    : 22, 2222, 2223
Dropbear   : 109, 143
WS         : -
SSL WS     : -
UDPGW      : 7300, 7301, 7302

🔗 LINK
OVPN       : https://${DOMAIN}/
Save       : https://${DOMAIN}/ssh-${USERNAME}.txt
HTTP UDP   : ${DOMAIN}:1-65535@${USERNAME}:${PASSWORD}

📡 PAYLOAD
GET / HTTP/1.1[crlf]
Host: ${DOMAIN}[crlf]
Upgrade: websocket[crlf][crlf]
EOF

cat /etc/xray/sshx/akun/log-create-${USERNAME}.log
