#!/bin/bash
set -e
USERNAME="$1"; EXPIRED_AT="$2"; IPLIMIT="${3:-5}"
if [ -z "$USERNAME" ] || [ -z "$EXPIRED_AT" ]; then echo "Usage: vmess-create-account USERNAME expired|trial IPLIMIT"; exit 1; fi
[ "$EXPIRED_AT" = "trial" ] && EXPIRED_AT=$(date -d "+1 hour" "+%Y-%m-%d %H:%M")
[ "$IPLIMIT" = "0" ] && IPLIMIT="9999"
IP=$(cat /etc/xray/ip 2>/dev/null || curl -4 -s ipv4.icanhazip.com || true)
ISP=$(cat /etc/xray/isp 2>/dev/null || echo "Unknown ISP")
CITY=$(cat /etc/xray/city 2>/dev/null || echo "Unknown City")
DOMAIN=$(cat /etc/xray/domain)
UUID=$(cat /proc/sys/kernel/random/uuid)
mkdir -p /etc/vmess/akun /var/www/html
echo "$IPLIMIT" >/etc/vmess/${USERNAME}IP
sed -i "/^#vm ${USERNAME} /,/^,{/d" /etc/xray/config.json
sed -i "/^#vmg ${USERNAME} /,/^,{/d" /etc/xray/config.json
sed -i '/#vmess$/a\#vm '"$USERNAME $EXPIRED_AT"'\
,{"id": "'""${UUID}""'","alterId": 0,"email": "'""${USERNAME}""'"}' /etc/xray/config.json
sed -i '/#vmessgrpc$/a\#vmg '"$USERNAME $EXPIRED_AT"'\
,{"id": "'""${UUID}""'","alterId": 0,"email": "'""${USERNAME}""'"}' /etc/xray/config.json
sync_xray() {
    mkdir -p /usr/local/etc/xray

    python3 <<'PYX'
import re
from pathlib import Path

src = Path("/etc/xray/config.json")
dst = Path("/usr/local/etc/xray/config.json")

s = src.read_text()
s = re.sub(r'^\s*#.*$', '', s, flags=re.MULTILINE)
s = re.sub(r',\s*}', '}', s)
s = re.sub(r',\s*]', ']', s)

dst.write_text(s)
PYX

    chmod 755 /usr/local/etc /usr/local/etc/xray
    chmod 644 /usr/local/etc/xray/config.json

    if command -v xray >/dev/null 2>&1; then
        xray run -test -config /usr/local/etc/xray/config.json >/tmp/smilevpn-xray-test.log 2>&1 || {
            cat /tmp/smilevpn-xray-test.log
            exit 1
        }
    fi

    systemctl restart xray >/dev/null 2>&1 || true
}
sync_xray
JSON_TLS=$(jq -nc --arg username "$USERNAME" --arg domain "$DOMAIN" --arg uuid "$UUID" '{v:"2",ps:$username,add:$domain,port:"443",id:$uuid,aid:"0",net:"ws",path:("/vmess/" + $username),type:"none",host:$domain,tls:"tls"}')
JSON_NTLS=$(jq -nc --arg username "$USERNAME" --arg domain "$DOMAIN" --arg uuid "$UUID" '{v:"2",ps:$username,add:$domain,port:"80",id:$uuid,aid:"0",net:"ws",path:("/vmess/" + $username),type:"none",host:$domain,tls:""}')
JSON_GRPC=$(jq -nc --arg username "$USERNAME" --arg domain "$DOMAIN" --arg uuid "$UUID" '{v:"2",ps:$username,add:$domain,port:"443",id:$uuid,aid:"0",net:"grpc",path:"vmess-grpc",type:"none",host:$domain,tls:"tls"}')
VMESS_LINK_TLS="vmess://$(echo -n "$JSON_TLS" | base64 -w0)"
VMESS_LINK_NTLS="vmess://$(echo -n "$JSON_NTLS" | base64 -w0)"
VMESS_LINK_GRPC="vmess://$(echo -n "$JSON_GRPC" | base64 -w0)"
cat >/var/www/html/vmess-${USERNAME}.txt <<END
proxies:
- name: ${USERNAME}-VMESS-WS-TLS
  server: ${DOMAIN}
  port: 443
  type: vmess
  uuid: ${UUID}
  alterId: 0
  cipher: auto
  tls: true
  servername: ${DOMAIN}
  network: ws
  ws-opts:
    path: /vmess/${USERNAME}
    headers:
      Host: ${DOMAIN}
  udp: true

- name: ${USERNAME}-VMESS-WS-NTLS
  server: ${DOMAIN}
  port: 80
  type: vmess
  uuid: ${UUID}
  alterId: 0
  cipher: auto
  tls: false
  network: ws
  ws-opts:
    path: /vmess/${USERNAME}
    headers:
      Host: ${DOMAIN}
  udp: true

- name: ${USERNAME}-VMESS-GRPC
  server: ${DOMAIN}
  port: 443
  type: vmess
  uuid: ${UUID}
  alterId: 0
  cipher: auto
  tls: true
  servername: ${DOMAIN}
  network: grpc
  grpc-opts:
    grpc-service-name: vmess-grpc
  udp: true

# Links
${VMESS_LINK_TLS}
${VMESS_LINK_NTLS}
${VMESS_LINK_GRPC}
END
cat >/etc/vmess/akun/log-create-${USERNAME}.log <<END
🔐 VMESS ACCOUNT

Username   : ${USERNAME}
UUID       : ${UUID}
Expired    : ${EXPIRED_AT}
Limit IP   : ${IPLIMIT} IP

🌐 SERVER
Domain     : ${DOMAIN}
IP         : ${IP}
ISP        : ${ISP}
City       : ${CITY}

🔌 PORT
TLS        : 443
Non TLS    : 80
gRPC       : 443
Path       : /vmess/${USERNAME}
Service    : vmess-grpc

<<<<<<< HEAD
🚀 UDP CUSTOM
UDP Port   : 1-65535
BadVPN     : 7300-7302

=======
>>>>>>> 9597f3a39a3a03153bfcb749f7317def6c29f7b8
🔗 LINK
OpenClash  : https://${DOMAIN}/vmess-${USERNAME}.txt

TLS
${VMESS_LINK_TLS}

Non TLS
${VMESS_LINK_NTLS}

gRPC
${VMESS_LINK_GRPC}
END
cat /etc/vmess/akun/log-create-${USERNAME}.log
