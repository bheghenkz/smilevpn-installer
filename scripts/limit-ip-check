#!/bin/bash
set -euo pipefail

LOCK="/run/smilevpn-limit-ip-check.lock"
exec 9>"$LOCK"
flock -n 9 || exit 0

LOG="/var/log/xray/access.log"
STATE_DIR="/etc/limit-state"
CONF="/etc/xray/config.json"
PANEL_URL="$(cat /etc/smilevpn-panel-url 2>/dev/null || true)"
API_TOKEN="$(cat /etc/smilevpn-api-token 2>/dev/null || true)"
SERVER_IP4="$(curl -s4 --max-time 3 ifconfig.me 2>/dev/null || hostname -I | awk '{print $1}')"

mkdir -p "$STATE_DIR"

send_log() {
    [ -z "$PANEL_URL" ] && return 0
    [ -z "$API_TOKEN" ] && return 0
    PANEL_URL="${PANEL_URL%/}"
    case "$PANEL_URL" in */api/security/ip-limit) ;; *) PANEL_URL="$PANEL_URL/api/security/ip-limit" ;; esac

    curl -sS -m 6 -X POST "$PANEL_URL" \
        -H "Authorization: Bearer $API_TOKEN" \
        -H "Content-Type: application/json" \
        --data-binary "{
          \"username\":\"$1\",
          \"service\":\"$2\",
          \"limit\":$3,
          \"count\":$4,
          \"ips\":\"$5\",
          \"strike\":$6,
          \"action\":\"$7\",
          \"blocked_until\":\"$8\"
        }" >>/var/log/smilevpn-iplimit-panel.log 2>&1 || true
}

is_user_exists() {
    local user="$1"
    grep -q "\"email\": \"$user\"" "$CONF" 2>/dev/null
}

count_ips() {
    local user="$1"
    local service="$2"
    local path=""

    case "$service" in
        trojan) path="/trojan-ws/$user" ;;
        vmess) path="/vmess/$user" ;;
        vless) path="/vless/$user" ;;
        shadowsocks) path="/ss-ws/$user" ;;
        vless-reality) path="" ;;
                trojango) path="JOURNAL_TROJANGO" ;;
trojango) path="JOURNAL_TROJANGO" ;;
        *) path="" ;;
    esac

    python3 - "$user" "$path" "$SERVER_IP4" "$LOG" <<'PYCODE'
import ipaddress, re, sys, subprocess
from datetime import datetime, timedelta

user, path, server_ip, xray_log = sys.argv[1:5]
ips = set()
now = datetime.now()
cutoff = now - timedelta(seconds=90)

def good(ip):
    try:
        obj = ipaddress.ip_address(ip)
    except Exception:
        return False
    if obj.version != 4:
        return False
    if ip == server_ip:
        return False
    if obj.is_private or obj.is_loopback or obj.is_link_local or obj.is_multicast or obj.is_unspecified:
        return False
    cf = [
        "173.245.48.0/20","103.21.244.0/22","103.22.200.0/22","103.31.4.0/22",
        "141.101.64.0/18","108.162.192.0/18","190.93.240.0/20","188.114.96.0/20",
        "197.234.240.0/22","198.41.128.0/17","162.158.0.0/15","104.16.0.0/13",
        "104.24.0.0/14","172.64.0.0/13","131.0.72.0/22",
    ]
    return not any(obj in ipaddress.ip_network(n) for n in cf)

def nginx_recent(line):
    m = re.search(r"\[([0-9]{2}/[A-Za-z]{3}/[0-9]{4}:[0-9]{2}:[0-9]{2}:[0-9]{2}) [+-][0-9]{4}\]", line)
    if not m:
        return False
    try:
        t = datetime.strptime(m.group(1), "%d/%b/%Y:%H:%M:%S")
        return t >= cutoff
    except Exception:
        return False

def xray_recent(line):
    m = re.match(r"([0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})", line)
    if not m:
        return False
    try:
        t = datetime.strptime(m.group(1), "%Y/%m/%d %H:%M:%S")
        return t >= cutoff
    except Exception:
        return False

# TrojanGo: use recent systemd journal
if path == "JOURNAL_TROJANGO":
    out = subprocess.getoutput("journalctl -u trojan-go --since '90 seconds ago' --no-pager 2>/dev/null")
    for line in out.splitlines():
        m = re.search(r"from ([0-9]+(?:\.[0-9]+){3}):", line)
        if m and good(m.group(1)):
            ips.add(m.group(1))
    print("\n".join(sorted(ips)))
    sys.exit(0)

# WS/gRPC behind Nginx: use recent Nginx only, do not merge old Xray fallback
if path:
    out = subprocess.getoutput("tail -n 2000 /var/log/nginx/access.log 2>/dev/null")
    for line in out.splitlines():
        if path not in line:
            continue
        if not nginx_recent(line):
            continue
        parts = line.split()
        if parts and good(parts[0]):
            ips.add(parts[0])
    print("\n".join(sorted(ips)))
    sys.exit(0)

# Reality/direct fallback: recent Xray only
out = subprocess.getoutput(f"tail -n 2000 {xray_log} 2>/dev/null")
for line in out.splitlines():
    if f"email: {user}" not in line or " accepted " not in line:
        continue
    if not xray_recent(line):
        continue
    m = re.search(r"from (?:tcp:)?([0-9]+(?:\.[0-9]+){3}):", line)
    if m and good(m.group(1)):
        ips.add(m.group(1))

print("\n".join(sorted(ips)))
PYCODE
}

check_xray() {
    local dir="$1"
    local service="$2"

    [ -d "$dir" ] || return 0

    for f in "$dir"/*IP; do
        [ -f "$f" ] || continue

        local user limit strike_file block_file ips_file cooldown_file now block_until
        user="$(basename "$f" IP)"
        limit="$(tr -dc '0-9' < "$f")"
        [ -z "$limit" ] && limit=0
        [ "$limit" = "0" ] && continue

        if ! is_user_exists "$user"; then
            rm -f "$STATE_DIR/$service-$user."*
            continue
        fi

        strike_file="$STATE_DIR/$service-$user.strike"
        block_file="$STATE_DIR/$service-$user.blocked_until"
        ips_file="$STATE_DIR/$service-$user.ips"
        cooldown_file="$STATE_DIR/$service-$user.cooldown"
        now="$(date +%s)"

        if [ -f "$block_file" ]; then
            block_until="$(cat "$block_file" 2>/dev/null || echo 0)"
            if [ "$block_until" -gt "$now" ] 2>/dev/null; then
                continue
            fi
            rm -f "$block_file"
            /usr/local/sbin/smilevpn/unblock-xray-user "$service" "$user" >/dev/null 2>&1 || true
            echo $((now + 60)) > "$cooldown_file"
            send_log "$user" "$service" "$limit" 0 "unknown" 0 "unblock" ""
            continue
        fi

        if [ -f "$cooldown_file" ]; then
            local cd
            cd="$(cat "$cooldown_file" 2>/dev/null || echo 0)"
            if [ "$cd" -gt "$now" ] 2>/dev/null; then
                echo "unknown" > "$ips_file"
                continue
            fi
            rm -f "$cooldown_file"
        fi

        local ips count ips_comma allow strike
        ips="$(count_ips "$user" "$service" || true)"
        count="$(echo "$ips" | sed '/^$/d' | wc -l)"
        ips_comma="$(echo "$ips" | sed '/^$/d' | paste -sd "," -)"
        [ -z "$ips_comma" ] && ips_comma="unknown"
        echo "$ips_comma" > "$ips_file"

        allow=$((limit + 3))
        [ "$limit" -ge 5 ] && allow=$((limit + 5))

        if [ "$count" -le "$allow" ]; then
            echo 0 > "$strike_file"
            continue
        fi

        strike="$(cat "$strike_file" 2>/dev/null || echo 0)"
        strike=$((strike + 1))
        echo "$strike" > "$strike_file"

        if [ "$strike" -lt 3 ]; then
            send_log "$user" "$service" "$limit" "$count" "$ips_comma" "$strike" "strike" ""
            continue
        fi

        local seconds until_text
        seconds=300
        [ "$strike" -ge 5 ] && seconds=900
        block_until=$((now + seconds))
        until_text="$(date -d "@$block_until" '+%F %T' 2>/dev/null || echo "$block_until")"

        echo "$block_until" > "$block_file"
        /usr/local/sbin/smilevpn/block-xray-user "$service" "$user" >/dev/null 2>&1 || true
        send_log "$user" "$service" "$limit" "$count" "$ips_comma" "$strike" "block" "$until_text"
    done
}

check_xray "/etc/trojan" "trojan"
check_xray "/etc/vmess" "vmess"
check_xray "/etc/vless" "vless"
check_xray "/etc/shadowsocks" "shadowsocks"
check_xray "/etc/vlessreality" "vless-reality"
check_xray "/etc/trojango" "trojango"


# Trojango and ZiVPN intentionally skipped until real user-IP parser is verified.
exit 0
