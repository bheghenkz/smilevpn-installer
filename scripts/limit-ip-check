#!/bin/bash

LOG="/var/log/xray/access.log"
STATE_DIR="/etc/smilevpn-limit"
PANEL_URL=$(cat /etc/smilevpn-panel-url 2>/dev/null)
API_TOKEN=$(cat /etc/smilevpn-api-token 2>/dev/null)
mkdir -p "$STATE_DIR"

send_log() {
    [ -z "$PANEL_URL" ] && return
    [ -z "$API_TOKEN" ] && return

    curl -s -X POST "$PANEL_URL/api/security/ip-limit" \
        -H "Authorization: Bearer $API_TOKEN" \
        -H "Content-Type: application/json" \
        -d "{
            \"username\": \"$1\",
            \"service\": \"$2\",
            \"limit\": $3,
            \"count\": $4,
            \"ips\": \"$5\",
            \"strike\": $6,
            \"action\": \"$7\",
            \"blocked_until\": \"$8\"
        }" >/dev/null 2>&1 &
}

now_ts() {
    date +%s
}

to_ts() {
    date -d "$1" +%s 2>/dev/null || echo 0
}

check_xray() {
    DIR="$1"
    SERVICE="$2"

    [ -d "$DIR" ] || return
    [ -f "$LOG" ] || return

    for f in "$DIR"/*IP; do
        [ -f "$f" ] || continue

        USER=$(basename "$f" IP)
        LIMIT=$(cat "$f" | tr -dc '0-9')

        [ -z "$LIMIT" ] && LIMIT=0
        [ "$LIMIT" = "0" ] && continue

        STRIKE_FILE="$STATE_DIR/$SERVICE-$USER.strike"
        BLOCK_FILE="$STATE_DIR/$SERVICE-$USER.blocked_until"
        SUSPEND_FILE="$STATE_DIR/$SERVICE-$USER.suspended"

        # 🔥 AUTO UNSUSPEND
if [ -f "$SUSPEND_FILE" ]; then
    SUSPEND_AT=$(cat "$SUSPEND_FILE")
    SUSPEND_TS=$(to_ts "$SUSPEND_AT")
    NOW_TS=$(now_ts)

    if [ $((NOW_TS - SUSPEND_TS)) -ge 86400 ]; then
        echo "UNSUSPEND: $SERVICE $USER (24h passed)"
        rm -f "$SUSPEND_FILE"
        echo "2" > "$STRIKE_FILE"
        systemctl restart xray >/dev/null 2>&1
    else
        continue
    fi
fi

        if [ -f "$BLOCK_FILE" ]; then
            BLOCK_UNTIL=$(cat "$BLOCK_FILE")
            BLOCK_TS=$(to_ts "$BLOCK_UNTIL")
            NOW_TS=$(now_ts)

            if [ "$BLOCK_TS" -gt "$NOW_TS" ]; then
                continue
            else
                rm -f "$BLOCK_FILE"
            fi
        fi

        IPS=$(grep -w "$USER" "$LOG" 2>/dev/null \
            | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' \
            | sort -u)

        COUNT=$(echo "$IPS" | sed '/^$/d' | wc -l)
        IPS_COMMA=$(echo "$IPS" | paste -sd "," -)

        if [ "$COUNT" -le "$LIMIT" ]; then
            continue
        fi

        STRIKE=$(cat "$STRIKE_FILE" 2>/dev/null || echo 0)
        STRIKE=$((STRIKE + 1))
        echo "$STRIKE" > "$STRIKE_FILE"

        if [ "$STRIKE" -eq 1 ]; then
            BLOCK_TIME=$(date -d "+1 hour" "+%Y-%m-%d %H:%M:%S")
            echo "$BLOCK_TIME" > "$BLOCK_FILE"
            echo "LIMIT HIT: $SERVICE $USER ($COUNT/$LIMIT) STRIKE 1 IPs: [$IPS_COMMA] -> BLOCK until $BLOCK_TIME"
            send_log "$USER" "$SERVICE" "$LIMIT" "$COUNT" "$IPS_COMMA" 1 "Block 1 hour" "$BLOCK_TIME"
            systemctl restart xray >/dev/null 2>&1

        elif [ "$STRIKE" -eq 2 ]; then
            BLOCK_TIME=$(date -d "+3 hour" "+%Y-%m-%d %H:%M:%S")
            echo "$BLOCK_TIME" > "$BLOCK_FILE"
            echo "LIMIT HIT: $SERVICE $USER ($COUNT/$LIMIT) STRIKE 2 IPs: [$IPS_COMMA] -> BLOCK until $BLOCK_TIME"
            send_log "$USER" "$SERVICE" "$LIMIT" "$COUNT" "$IPS_COMMA" 2 "Block 3 hours" "$BLOCK_TIME"
            systemctl restart xray >/dev/null 2>&1

        else
            echo "LIMIT HIT: $SERVICE $USER ($COUNT/$LIMIT) STRIKE 3 IPs: [$IPS_COMMA] -> SUSPENDED"
            send_log "$USER" "$SERVICE" "$LIMIT" "$COUNT" "$IPS_COMMA" 3 "Suspended 24 hours" ""
            echo "$(date '+%Y-%m-%d %H:%M:%S')" > "$SUSPEND_FILE"
            rm -f "$BLOCK_FILE"

            case "$SERVICE" in
                trojan)
                    sed -i "/#tr $USER /,/^#tr /{/#tr $USER /d; /\"email\": \"$USER\"/d}" /etc/xray/config.json
                    ;;
                vmess)
                    sed -i "/#vm $USER /,/^#vm /{/#vm $USER /d; /\"email\": \"$USER\"/d}" /etc/xray/config.json
                    ;;
                vless)
                    sed -i "/#vl $USER /,/^#vl /{/#vl $USER /d; /\"email\": \"$USER\"/d}" /etc/xray/config.json
                    ;;
            esac

            systemctl restart xray >/dev/null 2>&1
        fi
    done
}

check_ssh() {
    DIR="/etc/xray/sshx"
    [ -d "$DIR" ] || return

    for f in "$DIR"/*IP; do
        [ -f "$f" ] || continue

        USER=$(basename "$f" IP)
        LIMIT=$(cat "$f" | tr -dc '0-9')

        [ -z "$LIMIT" ] && LIMIT=0
        [ "$LIMIT" = "0" ] && continue

        SSH_SESSIONS=$(who | grep -w "$USER")
        COUNT=$(echo "$SSH_SESSIONS" | sed '/^$/d' | wc -l)
        SSH_IPS=$(echo "$SSH_SESSIONS" | awk '{print $5}' | tr -d '()' | sort -u | paste -sd "," -)

        if [ "$COUNT" -gt "$LIMIT" ]; then
            echo "LIMIT HIT: ssh $USER ($COUNT/$LIMIT) IPs: [$SSH_IPS] -> KILL SESSION"
            send_log "$USER" "ssh" "$LIMIT" "$COUNT" "$SSH_IPS" 1 "Kill SSH session" ""
            pkill -u "$USER" >/dev/null 2>&1
        fi
    done
}

check_xray "/etc/trojan" "trojan"
check_xray "/etc/vmess" "vmess"
check_xray "/etc/vless" "vless"
check_ssh
